EBIRD_API_KEY=your_key_here

# Optional: default path to a CSV of species you've already seen (life list,
# year list, whatever). Skips having to pass --seen-list every run.
# BIGYEAR_SEEN_LIST=/home/sara/Downloads/MyEBirdData.csv

# Optional: default path to your eBird life-list CSV. Species not on it are
# flagged as lifers in the various listings.
# BIGYEAR_LIFE_LIST=/home/sara/Downloads/ebird_world_life_list.csv

# Optional: default regions for the `refresh` command (falls back to "world").
# BIGYEAR_YEAR_REGION=CA-BC
# BIGYEAR_LIFE_REGION=world

# Optional: only needed for the `leaving` command, which hits ebird.org's
# undocumented bar-chart endpoint. Log in at ebird.org, open devtools →
# Application → Cookies → ebird.org, copy the value of EBIRD_SESSIONID, and
# paste it here (no quotes). Expires periodically — re-copy when it 403s.
# EBIRD_SESSION=
